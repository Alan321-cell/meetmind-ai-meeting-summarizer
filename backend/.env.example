# ==============================================================================
# MeetMind — AI Meeting Summarizer Configuration
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
DEBUG=True

# SQLite Database Connection URL
DATABASE_URL=sqlite:///./meetmind.db

# Speech-to-Text (ASR) Provider: "auto" | "openai" | "groq" | "mock"
# - "auto": Uses Groq if GROQ_API_KEY is present, then OpenAI, else deterministic offline mock
ASR_PROVIDER=auto

# LLM Intelligence Provider: "auto" | "openai" | "groq" | "mock"
LLM_PROVIDER=auto

# OpenAI Configuration (Whisper ASR & GPT-4o / GPT-4o-mini)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Groq Configuration (Ultra-fast Whisper Large v3 & Llama 3.3 70B)
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=100
